# Backend-only hosting adapter configuration. AWS provisioning remains dry-run until explicitly configured.
HOSTING_PROVIDER=aws_ec2
HOSTING_DRY_RUN=true
AWS_REGION=us-east-1
AWS_AMI_ID=
AWS_INSTANCE_TYPE=t3.medium
AWS_SUBNET_ID=
AWS_SECURITY_GROUP_ID=
AWS_IAM_INSTANCE_PROFILE=

# Required in production:
# DATABASE_URL=postgresql://...
# JWT_SECRET=replace-with-a-long-random-secret

# --- Required by docker-compose (generate real random values; never commit backend/.env) ---
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://xau_user:<POSTGRES_PASSWORD>@db:5432/xau_pilot_db
# JWT_SECRET=            # python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Developer EA releases ---
# MANIFEST_SIGNING_KEY=  # >= 32 chars, DIFFERENT from JWT_SECRET. Server-side only; publishing is refused without it.
# EA_STORAGE_DIR=/var/ea_packages   # private directory for .ex5 files (never served statically)
# EA_MAX_BINARY_BYTES=26214400      # upload size limit (25 MB)
# EA_SCAN_COMMAND=clamdscan --no-summary   # optional malware scanner; exit 0 clean, 1 infected

# CORS origins for the web dashboard/admin portal (Android native app does not use browser CORS).
ALLOWED_ORIGINS=https://app.xaupilot.com,https://portal.xaupilot.com

ENVIRONMENT=production

# One-time first Super Admin setup. Set a random value of at least 32 characters in hosting secrets.
SUPER_ADMIN_BOOTSTRAP_TOKEN=
